import matplotlib.pyplot as plt
import sys

# Usage: python plot_sg.py data.txt
# Where data.txt is captured from CoolTerm with lines like "Raw: 1234 Filtered: -56"

if len(sys.argv) != 2:
    print("Usage: python plot_sg.py <filename>")
    sys.exit(1)

filename = sys.argv[1]

raw_data = []
filtered_data = []

with open(filename, 'r') as f:
    for line in f:
        line = line.strip()
        if line.startswith("Raw: ") and " Filtered: " in line:
            parts = line.split(" Filtered: ")
            if len(parts) == 2:
                try:
                    raw_val = float(parts[0].replace("Raw: ", ""))
                    filtered_val = float(parts[1])
                    raw_data.append(raw_val)
                    filtered_data.append(filtered_val)
                except ValueError:
                    continue

if not raw_data or not filtered_data:
    print("No valid data found in file")
    sys.exit(1)

# Plot
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8))

ax1.plot(raw_data, color='blue')
ax1.set_title('Raw Signal Data')
ax1.set_xlabel('Sample Index')
ax1.set_ylabel('Signal Value')
ax1.grid(True)

ax2.plot(filtered_data, color='red')
ax2.set_title('Savitzky-Golay Filtered Data (Derivative)')
ax2.set_xlabel('Sample Index')
ax2.set_ylabel('Derivative Value')
ax2.grid(True)

plt.tight_layout()
plt.show()
